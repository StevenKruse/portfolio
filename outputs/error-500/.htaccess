# Redirect the non-www domain to the preferred HTTPS www address.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^stevenkruse\.com$ [NC]
RewriteRule ^ https://www.stevenkruse.com%{REQUEST_URI} [R=301,L,NE]

# Show the custom page while preserving the HTTP 404 status.
ErrorDocument 404 /404.html

# Show the custom server-error page while preserving the HTTP 500 status.
ErrorDocument 500 /500.html
